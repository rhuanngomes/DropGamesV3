# Chave usada apenas no servidor/proxy local do Vite.
# Nunca exponha esta chave em codigo React, commits ou arquivos publicos.
STEAM_WEB_API_KEY=sua_chave_da_steam_web_api_aqui

# IA generativa usada apenas no servidor local do Vite.
# Escolha um provedor e nunca coloque essas chaves em arquivos dentro de src/ ou public/.
AI_PROVIDER=openai
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Alternativa caso o grupo prefira Anthropic.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
