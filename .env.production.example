NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# URL publica, sempre com HTTPS e sem barra no final.
APP_URL=https://seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
AUTH_COOKIE_SECURE=true

# Persistencia local. Faça backup deste arquivo e mantenha apenas uma instancia PM2.
DATA_FILE=./data/dropgames-auth.json

# Administrador inicial. Use uma senha nova, forte e exclusiva.
ADMIN_NAME=Rhuann Gomes
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-e-exclusiva
SEED_DEMO_USERS=false

STEAM_WEB_API_KEY=sua_chave_steam

AI_PROVIDER=openai
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL=gpt-4o-mini

# Alternativa:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sua_chave_anthropic
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
